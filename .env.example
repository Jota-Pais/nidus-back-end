# Copie para .env e preencha. O .env nunca vai para o repositorio.

# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta da API
PORT=3333

# Postgres na Neon. NAO edite estas duas a mao: sao escritas por
# `neon link` e `neon deploy`, que puxam do branch linkado.
#   DATABASE_URL           pooled   -> a aplicacao, via driver adapter
#   DATABASE_URL_UNPOOLED  direta   -> a CLI do Prisma (migrations, studio)
# O banco e o `neondb` padrao do branch, de proposito: a Neon sempre
# aponta o DATABASE_URL para ele, e usar outro nome faz o valor ser
# sobrescrito a cada deploy - falha silenciosa, o app conecta num banco vazio.
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"

# Origem do front-end autorizada a chamar a API (CORS).
# Local: http://localhost:5173  |  Producao: https://<projeto>.vercel.app
CORS_ORIGEM=http://localhost:5173
