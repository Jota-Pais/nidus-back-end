# Copie para .env e preencha. O .env nunca vai para o repositorio.

# Ambiente de execucao: development | test | production
NODE_ENV=development

# Porta da API
PORT=3333

# Postgres na Neon - pegue a connection string no painel do projeto.
# E o mesmo banco para todo mundo: nao existe Postgres local nem container.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/nidus?sslmode=require"

# Origem do front-end autorizada a chamar a API (CORS).
# Local: http://localhost:5173  |  Producao: https://<projeto>.vercel.app
CORS_ORIGEM=http://localhost:5173
