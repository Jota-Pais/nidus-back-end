// Modelo fisico do Nidus. Fonte da verdade do banco: este arquivo
// gera as migrations, nunca o contrario.
//
// O que o Prisma nao expressa (CHECK, unique parcial, FK composta e triggers)
// esta escrito a mao nas migrations SQL de prisma/migrations/.
//
// Ha um banco so, o de producao na Neon. Mudar model, campo ou mapeamento exige
// migration nova aplicada nele; comentario nao gera migration.
//
// Nomes do banco via @map/@@map: um schema por modulo, tabela snake_case no
// singular, FK `id_<tabela>`, datas com `dt_`, dominios fechados por CHECK (sem
// enum do Prisma) e NO ACTION em toda FK, porque registro nao se apaga. Dominio
// novo ou reescrito guarda a palavra (vivo, entregue, estoque); a letra so ficou
// onde o dominio nao mudou (sexo M/F, perfil, situacao do projeto).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["infra", "catalogo", "reproducao", "colonia", "login", "etica", "demanda", "auditoria"]
}

// ---------------------------------------------------------------- infra

/// Sala de criacao. Existe sem estante, e o nome mora so aqui: renomear muda
/// todas as estantes dela. Remover e `ativa = false`, so sem estante ativa.
model Sala {
  id           Int       @id @default(autoincrement())
  nome         String    @db.VarChar(60)
  ativa        Boolean   @default(true)
  dtCriacao    DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  estantes Estante[]

  @@map("sala")
  @@schema("infra")
}

/// Formato = as medidas de um modelo de estante (faces, linhas e colunas). A estante aponta para
/// ele, e mudar as medidas muda as estantes dele: o banco reescreve o codigo das caixas ativas e
/// recusa (TOPOLOGIA) a que ficaria fora (trigger infra.formato_reescreve_as_caixas). Faces x
/// colunas nao passa das 26 letras do endereco (CHECK formato_topologia). O nome e unico entre os
/// ativos, sem diferenciar maiuscula (unique parcial formato_nome_unico, na migration SQL). Remover
/// e `ativo = false`, so sem estante ativa.
model Formato {
  id           Int       @id @default(autoincrement())
  nome         String    @db.VarChar(60)
  /// 1 frontal, 2 frontal e traseira
  faces        Int       @db.SmallInt
  linhas       Int       @db.SmallInt
  colunas      Int       @db.SmallInt
  ativo        Boolean   @default(true)
  dtCriacao    DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  estantes Estante[]

  @@map("formato")
  @@schema("infra")
}

/// Rack numa sala, com as medidas do formato dele. A capacidade nao e gravada: sai do formato
/// (faces x linhas x colunas). O formato muda depois do cadastro, e o banco reescreve o codigo das
/// caixas ativas e recusa (TOPOLOGIA) a que ficaria fora (trigger infra.estante_reescreve_as_caixas);
/// remover e `ativa = false`, so com a estante vazia.
model Estante {
  id            Int       @id @default(autoincrement())
  idSala        Int       @map("id_sala")
  idFormato     Int       @map("id_formato")
  /// Como a etiqueta aparece na estante real.
  numeroVisivel String    @map("numero_visivel") @db.VarChar(30)
  ativa         Boolean   @default(true)
  dtCriacao     DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao  DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  sala    Sala    @relation(fields: [idSala], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formato Formato @relation(fields: [idFormato], references: [id], onDelete: NoAction, onUpdate: NoAction)
  caixas  Caixa[]

  @@index([idFormato])
  @@map("estante")
  @@schema("infra")
}

/// A gaiola que ocupa uma posicao: so o lugar. Os animais apontam para ela
/// (colonia.animal.id_caixa), e o que ela tem e sempre contado, nunca gravado.
/// Nao existe tabela `slot`: o endereco vive na propria caixa e a grade vazia se
/// gera em codigo a partir das medidas do formato da estante.
model Caixa {
  id        Int @id @default(autoincrement())
  idEstante Int @map("id_estante")
  /// 1 frontal, 2 traseira. A face faz parte do endereco, nao e sufixo.
  face      Int @db.SmallInt
  linha     Int @db.SmallInt
  coluna    Int @db.SmallInt
  /// Endereco legivel (ex.: F1A). Quem escreve e o trigger da posicao
  /// (infra.caixa_dentro_da_topologia), com a mesma formula de `codigoDaPosicao`, e ele
  /// reescreve o da caixa ativa quando o formato da estante muda. A liberada guarda o da saida.
  codigo    String @default("") @db.VarChar(20)
  /// A segregacao por especie e aplicada no servidor.
  idEspecie Int @map("id_especie")
  /// casal | estoque. Qualquer posicao vazia vira uma ou outra, e a caixa do casal
  /// encerrado pode virar de estoque no lugar.
  tipo      String  @default("casal") @db.VarChar(10)
  /// So na caixa de estoque, e ela sempre tem: M ou F
  sexo      String? @db.Char(1)
  /// So na caixa de estoque, e ela sempre tem. A especie dela e conferida pelo
  /// trigger dos animais.
  idLinhagem Int?   @map("id_linhagem")
  ativa      Boolean @default(true)
  /// Data do fato que esvaziou a caixa (a entrega, a baixa, a mudanca), nao o
  /// relogio do servidor. Nula enquanto ativa.
  dtLiberacao     DateTime? @map("dt_liberacao") @db.Date
  /// entrega | baixa | mudanca | casal_encerrado
  motivoLiberacao String?   @map("motivo_liberacao") @db.VarChar(20)
  dtCriacao    DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  estante  Estante   @relation(fields: [idEstante], references: [id], onDelete: NoAction, onUpdate: NoAction)
  especie  Especie   @relation(fields: [idEspecie], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linhagem Linhagem? @relation(fields: [idLinhagem], references: [id], onDelete: NoAction, onUpdate: NoAction)
  casais   Casal[]
  /// Os vivos que estao nela e os que sairam dela (mortos e entregues ficam onde
  /// estavam quando sairam)
  animais  Animal[]
  ocorrenciasDeOrigem  Ocorrencia[] @relation("OrigemDaOcorrencia")
  ocorrenciasDeDestino Ocorrencia[] @relation("DestinoDaOcorrencia")

  @@index([idEstante, face])
  @@map("caixa")
  @@schema("infra")
}

// ------------------------------------------------------------- catalogo

model Especie {
  id             Int    @id @default(autoincrement())
  /// Rato | Camundongo
  nome           String @db.VarChar(40)

  linhagens Linhagem[]
  caixas    Caixa[]
  pedidos   Pedido[]

  @@unique([nome])
  @@map("especie")
  @@schema("catalogo")
}

/// Wistar, SHR, Kyoto (rato) | Swiss, C57BL/6J (camundongo). Nao sao
/// intercambiaveis: linhagem sempre coerente com a especie.
model Linhagem {
  id        Int     @id @default(autoincrement())
  idEspecie Int     @map("id_especie")
  nome      String  @db.VarChar(60)
  ativa     Boolean @default(true)
  /// Como se cruzam as familias A-E desta linhagem: 'rodizio' (heterogenica: macho A com
  /// femea B, B com C ... E com A) ou 'mesma_letra' (isogenica). Nulo: sem regra. So serve
  /// para avisar no casal; nunca impede o cadastro. O gestor muda nos Cadastros.
  cruzamento String? @db.VarChar(12)

  especie Especie @relation(fields: [idEspecie], references: [id], onDelete: NoAction, onUpdate: NoAction)
  casais  Casal[]
  pedidos Pedido[]
  /// As caixas de estoque desta linhagem
  caixas  Caixa[]
  /// As ninhadas desta linhagem, com casal ou sem
  partos  Parto[]

  /// Alvo da FK composta (id_especie, id_linhagem) que entra por SQL.
  @@unique([idEspecie, id])
  @@unique([idEspecie, nome])
  @@map("linhagem")
  @@schema("catalogo")
}

// ------------------------------------------------------------ reproducao

/// Maximo um casal ATIVO por caixa (unique parcial, na migration SQL).
/// Encerra no 5o parto confirmado. `ativo` vale se e somente se nao ha
/// `dtEncerramento` (CHECK casal_ativo_coerente).
model Casal {
  id         Int    @id @default(autoincrement())
  idCaixa    Int    @map("id_caixa")
  idLinhagem Int    @map("id_linhagem")
  /// Grupos A-E (CHECK no banco) em qualquer combinacao: o cruzamento depende da linhagem.
  grupoMacho String @map("grupo_macho") @db.Char(1)
  grupoFemea String @map("grupo_femea") @db.Char(1)
  /// 2 caracteres, primeiro e o grupo do macho. Ex.: AB.
  identificacao String @db.Char(2)

  dtFormacao         DateTime  @map("dt_formacao") @db.Date
  dtEncerramento     DateTime? @map("dt_encerramento") @db.Date
  motivoEncerramento String?   @map("motivo_encerramento") @db.VarChar(200)
  ativo              Boolean   @default(true)

  dtCriacao    DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  caixa    Caixa    @relation(fields: [idCaixa], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linhagem Linhagem @relation(fields: [idLinhagem], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partos   Parto[]

  /// Alvo da FK composta (id_casal, id_linhagem) do parto: a ninhada e da linhagem do casal.
  @@unique([id, idLinhagem])
  @@index([idCaixa, ativo])
  @@map("casal")
  @@schema("reproducao")
}

/// A ficha de um ciclo: as datas e quem as registrou. Quantos nasceram, morreram,
/// desmamaram e foram entregues nao fica aqui: e contado nos animais do parto
/// (colonia.animal), que tambem dao a idade e o sexo de cada um.
/// As datas previstas sao calculadas (src/modules/reproducao/cadeiaTemporal.ts).
///
/// Ha tambem a ninhada sem casal conhecido: a do cadastro inicial do estoque, com os
/// animais que ja estavam na colonia antes do Nidus. Ela nao tem casal, ordem nem
/// acasalamento, e tem sempre o nascimento (CHECK parto_ninhada_sem_casal).
model Parto {
  id      Int  @id @default(autoincrement())
  /// Nulo so na ninhada sem casal conhecido (cadastro inicial).
  idCasal Int? @map("id_casal")
  /// A linhagem da ninhada, e com ela a especie. Com casal, a do casal (FK composta).
  idLinhagem Int @map("id_linhagem")
  /// 1 a 5: o casal encerra no 5o parto. Nulo na ninhada sem casal.
  ordem   Int? @db.SmallInt

  /// Nulo na ninhada sem casal.
  dtAcasalamento   DateTime? @map("dt_acasalamento") @db.Date
  /// Nulo ate o nascimento. Na ninhada sem casal, o nascimento informado no cadastro.
  dtPartoReal      DateTime? @map("dt_parto_real") @db.Date
  dtDesmameReal    DateTime? @map("dt_desmame_real") @db.Date
  /// O acasalamento de casal encerrado que nao deu parto: fecha o ciclo sem
  /// ninhada, para a caixa poder ser liberada.
  dtSemNinhada     DateTime? @map("dt_sem_ninhada") @db.Date
  motivoSemNinhada String?   @map("motivo_sem_ninhada") @db.VarChar(200)

  /// Quem registrou cada evento e quando, para a trilha da ficha. `dtRegistro*`
  /// e o carimbo da ACAO no sistema (para ordenar e diferenciar dois registros
  /// no mesmo dia) - `dtPartoReal`/`dtDesmameReal` continuam sendo a data do fato
  /// biologico, decidida pelo usuario, nao pelo relogio do servidor.
  idUsuarioParto    Int?      @map("id_usuario_parto")
  dtRegistroParto   DateTime? @map("dt_registro_parto") @db.Timestamptz(6)
  idUsuarioDesmame  Int?      @map("id_usuario_desmame")
  dtRegistroDesmame DateTime? @map("dt_registro_desmame") @db.Timestamptz(6)

  dtCriacao    DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  /// FK COMPOSTA: a ninhada do casal e da linhagem dele. Sem casal, nao confere nada.
  casal          Casal?   @relation(fields: [idCasal, idLinhagem], references: [id, idLinhagem], onDelete: NoAction, onUpdate: NoAction)
  linhagem       Linhagem @relation(fields: [idLinhagem], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarioParto   Usuario? @relation("RegistrouParto", fields: [idUsuarioParto], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarioDesmame Usuario? @relation("RegistrouDesmame", fields: [idUsuarioDesmame], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// A ninhada: cada animal que nasceu deste parto, onde quer que esteja
  animais        Animal[]
  ocorrencias    Ocorrencia[]

  @@unique([idCasal, ordem])
  @@map("parto")
  @@schema("reproducao")
}

// --------------------------------------------------------------- colonia

/// Um animal. Anonimo: nenhum numero fisico, e dentro da caixa so a idade o
/// distingue dos outros do mesmo sexo. Nascimento, linhagem e especie vem do
/// parto, sem copia aqui.
///
/// Um lugar, uma situacao e no maximo um pedido por animal: sao colunas da
/// propria linha. Mudar de caixa e trocar `idCaixa`, que nao cria nem some rato.
/// O trigger colonia.animal_coerente cobra onde um vivo pode estar, as situacoes
/// finais e o teto do pedido.
model Animal {
  id          Int       @id @default(autoincrement())
  idParto     Int       @map("id_parto")
  sexo        String    @db.Char(1)
  /// Onde esta (vivo) ou onde estava quando saiu (morto, entregue, anulado)
  idCaixa     Int       @map("id_caixa")
  /// Quando chegou na caixa atual. Nulo: nunca mudou de caixa desde que nasceu
  dtMovimento DateTime? @map("dt_movimento") @db.Date
  /// vivo | morto (morte ou eutanasia, a selecao inclusive) | entregue |
  /// anulado (registro de animal que nao existiu, na correcao da contagem)
  situacao    String    @default("vivo") @db.VarChar(10)
  /// Data da morte ou da entrega
  dtSaida     DateTime? @map("dt_saida") @db.Date
  /// vivo: reservado para | entregue: entregue a | morto e anulado: estava
  /// reservado para (fica como registro)
  idPedido    Int?      @map("id_pedido")

  dtCriacao    DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  parto       Parto              @relation(fields: [idParto], references: [id], onDelete: NoAction, onUpdate: NoAction)
  caixa       Caixa              @relation(fields: [idCaixa], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedido      Pedido?            @relation(fields: [idPedido], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ocorrencias OcorrenciaAnimal[]

  @@index([idCaixa, situacao])
  @@index([idParto, sexo])
  @@index([idPedido])
  @@map("animal")
  @@schema("colonia")
}

/// O que aconteceu com os animais: a trilha. Cada acao sobre animais grava uma
/// ocorrencia ligada aos animais que tocou (ocorrencia_animal). O resto (pedido,
/// casal, datas, posicao) continua em auditoria.historico.
model Ocorrencia {
  id             Int      @id @default(autoincrement())
  /// nascimento | entrada (do cadastro inicial do estoque) | baixa (morte ou
  /// eutanasia, a selecao inclusive) | mudanca de caixa | reserva | reserva_desfeita |
  /// entrega | correcao (da contagem ou do sexo) | anulacao (de uma baixa)
  tipo           String   @db.VarChar(20)
  /// A data do fato, decidida pelo usuario
  dtFato         DateTime @map("dt_fato") @db.Date
  /// Nulo: o proprio sistema ou a conversao para este modelo
  idUsuario      Int?     @map("id_usuario")
  dtRegistro     DateTime @default(now()) @map("dt_registro") @db.Timestamptz(6)
  idParto        Int?     @map("id_parto")
  idCaixaOrigem  Int?     @map("id_caixa_origem")
  idCaixaDestino Int?     @map("id_caixa_destino")
  idPedido       Int?     @map("id_pedido")
  /// So na anulacao: a baixa anulada. A baixa se anula uma vez so, mas os
  /// animais dela podem voltar para mais de uma caixa (machos numa caixa de
  /// estoque, femeas noutra), e cada destino e uma ocorrencia de anulacao
  /// apontando a mesma baixa. Quem cobra o "uma vez so" e o codigo, com a baixa
  /// travada (colonia/baixa.service.ts)
  idAnulada      Int?     @map("id_anulada")
  motivo         String?  @db.VarChar(200)
  /// So na baixa, e toda baixa tem: morte | eutanasia (a selecao inclusive). O
  /// motivo continua o texto da trilha; a causa e o dado que a ficha e a visao
  /// geral contam (a eutanasia de ajuste de ninhada e a morte no aleitamento)
  causa          String?  @db.VarChar(10)

  usuario      Usuario?           @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parto        Parto?             @relation(fields: [idParto], references: [id], onDelete: NoAction, onUpdate: NoAction)
  caixaOrigem  Caixa?             @relation("OrigemDaOcorrencia", fields: [idCaixaOrigem], references: [id], onDelete: NoAction, onUpdate: NoAction)
  caixaDestino Caixa?             @relation("DestinoDaOcorrencia", fields: [idCaixaDestino], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedido       Pedido?            @relation(fields: [idPedido], references: [id], onDelete: NoAction, onUpdate: NoAction)
  anulada      Ocorrencia?        @relation("Anulacao", fields: [idAnulada], references: [id], onDelete: NoAction, onUpdate: NoAction)
  anulacoes    Ocorrencia[]       @relation("Anulacao")
  animais      OcorrenciaAnimal[]

  @@index([idAnulada])
  @@index([idParto])
  @@index([idCaixaOrigem])
  @@index([idCaixaDestino])
  @@index([idPedido])
  @@index([dtFato])
  @@map("ocorrencia")
  @@schema("colonia")
}

/// Os animais que uma ocorrencia tocou
model OcorrenciaAnimal {
  idOcorrencia Int @map("id_ocorrencia")
  idAnimal     Int @map("id_animal")

  ocorrencia Ocorrencia @relation(fields: [idOcorrencia], references: [id], onDelete: NoAction, onUpdate: NoAction)
  animal     Animal     @relation(fields: [idAnimal], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([idOcorrencia, idAnimal])
  @@index([idAnimal])
  @@map("ocorrencia_animal")
  @@schema("colonia")
}

// ---------------------------------------------------------------- login

model Usuario {
  id Int @id @default(autoincrement())
  /// SSO ID-UFSC. Fica como mock no semestre.
  idInstitucional String? @unique @map("id_institucional") @db.VarChar(60)
  nome            String  @db.VarChar(120)
  email           String  @unique @db.VarChar(160)
  /// P pesquisador | T tecnico | G gestor
  perfil          String  @db.Char(1)
  /// Senha local, independente do SSO, para nao perder o sistema se ele
  /// cair. Nulo para quem entra so pelo SSO.
  hashSenha String? @map("hash_senha") @db.VarChar(255)
  ativo     Boolean @default(true)
  dtCriacao DateTime @default(now()) @map("dt_criacao") @db.Timestamptz(6)

  projetosResponsavel Projeto[]
  pedidos             Pedido[]
  partosRegistrados   Parto[]      @relation("RegistrouParto")
  desmamesRegistrados Parto[]      @relation("RegistrouDesmame")
  ocorrencias         Ocorrencia[]
  historico           Historico[]

  @@map("usuario")
  @@schema("login")
}

/// Senha de suporte/desenvolvimento - decisao operacional do time (17/09/2026),
/// NAO e requisito do cliente. So a linha com `ativa=true` conta; nunca duas
/// ativas ao mesmo tempo (login.service.ts garante isso). Hash, nunca texto
/// puro - mesma regra de usuario.hash_senha.
model SenhaMestra {
  id           Int       @id @default(autoincrement())
  hashSenha    String    @map("hash_senha") @db.VarChar(255)
  ativa        Boolean   @default(true)
  dtCriacao    DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  @@map("senha_mestra")
  @@schema("login")
}

/// Codigo de primeiro acesso e de senha esquecida, mandado ao e-mail da UFSC. Sem FK
/// para usuario: o primeiro acesso pede codigo para e-mail que ainda nao tem conta.
/// Guarda so o hash do codigo. Linha nunca se apaga: os limites de pedido contam as
/// linhas por email e dt_criacao, e o teto total so por dt_criacao.
model CodigoAcesso {
  id         Int       @id @default(autoincrement())
  email      String    @db.VarChar(160)
  hashCodigo String    @map("hash_codigo") @db.VarChar(255)
  expiraEm   DateTime  @map("expira_em") @db.Timestamptz(6)
  /// Conferencias erradas, mais a que esta em andamento: o acerto devolve a sua. O
  /// codigo aceita 5, e o e-mail, 20 somando os codigos das ultimas 24 h.
  tentativas Int       @default(0) @db.SmallInt
  /// Quando o codigo deixou de valer: gasto na senha nova ou trocado por um codigo
  /// mais novo do mesmo e-mail.
  usadoEm    DateTime? @map("usado_em") @db.Timestamptz(6)
  dtCriacao  DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)

  @@index([email, dtCriacao])
  /// As contagens do teto total, sem e-mail: o indice de cima nao serve a elas.
  @@index([dtCriacao])
  @@map("codigo_acesso")
  @@schema("login")
}

// ----------------------------------------------------------------- etica

/// Projeto aprovado na CEUA. A cota fica so cadastrada: o cliente respondeu em
/// 20/09/2026 que ela e a liberacao do projeto, nao um saldo que cada pedido desconta.
model Projeto {
  id     Int    @id @default(autoincrement())
  /// O processo da UFSC, 23080.XXXXXX/AAAA-XX, ou os 10 digitos do Sistema CEUA
  /// (regra em src/modules/demanda/protocolo.ts).
  numero String @unique @db.VarChar(30)
  titulo String @db.VarChar(255)
  idUsuarioResponsavel Int @map("id_usuario_responsavel")

  dtVigenciaInicio DateTime @map("dt_vigencia_inicio") @db.Date
  dtVigenciaFim    DateTime @map("dt_vigencia_fim") @db.Date
  cotaAutorizada   Int      @map("cota_autorizada")
  /// V vigente | N vencido | S suspenso
  situacao         String   @default("V") @db.Char(1)

  dtCriacao    DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  usuarioResponsavel Usuario  @relation(fields: [idUsuarioResponsavel], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedidos            Pedido[]

  @@map("projeto")
  @@schema("etica")
}

// --------------------------------------------------------------- demanda

/// Pedido de animais de um pesquisador. A reserva e a entrega ficam nos animais
/// (colonia.animal.id_pedido): o pedido so tem o que foi pedido e o status, que o
/// trigger demanda.pedido_coerente confere contra os animais.
model Pedido {
  id                   Int @id @default(autoincrement())
  /// O protocolo CEUA que a pessoa digitou, conferido so no formato
  /// (src/modules/demanda/protocolo.ts). A equipe tecnica confere o resto ao analisar.
  protocoloCeua        String @map("protocolo_ceua") @db.VarChar(30)
  /// O projeto cadastrado com esse numero, quando existe. O pedido nao depende dele.
  idProjeto            Int? @map("id_projeto")
  idUsuarioSolicitante Int @map("id_usuario_solicitante")
  idEspecie            Int @map("id_especie")
  idLinhagem           Int @map("id_linhagem")
  /// O nome que a pessoa digitou no pedido. O e-mail e o da conta que pediu.
  nomePesquisador      String @map("nome_pesquisador") @db.VarChar(120)

  qtdM           Int      @map("qtd_m") @db.SmallInt
  qtdF           Int      @map("qtd_f") @db.SmallInt
  /// Animais de qualquer sexo, alem dos machos e das femeas.
  qtdQualquer    Int      @default(0) @map("qtd_qualquer") @db.SmallInt
  /// Faixa de idade na entrega, em dias. A idade exata e min = max.
  idadeMinDias   Int      @map("idade_min_dias") @db.SmallInt
  idadeMaxDias   Int      @map("idade_max_dias") @db.SmallInt
  dtDesejada     DateTime @map("dt_desejada") @db.Date
  /// enviado | aprovado (aguardando animais) | reservado | entregue | recusado
  status         String   @default("enviado") @db.VarChar(10)
  /// A data em que os animais foram entregues. Preenchida se e somente se o
  /// pedido esta entregue.
  dtEntrega      DateTime? @map("dt_entrega") @db.Date
  /// Texto livre do pesquisador. Nulo quando nao escreveu nada.
  observacoes    String?  @db.VarChar(500)

  dtCriacao    DateTime  @default(now()) @map("dt_criacao") @db.Timestamptz(6)
  dtManutencao DateTime? @map("dt_manutencao") @db.Timestamptz(6)

  projeto            Projeto? @relation(fields: [idProjeto], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarioSolicitante Usuario  @relation(fields: [idUsuarioSolicitante], references: [id], onDelete: NoAction, onUpdate: NoAction)
  especie            Especie  @relation(fields: [idEspecie], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// FK COMPOSTA: linhagem coerente com a especie. Wistar e de rato;
  /// pedir Wistar de camundongo o banco recusa, nao a aplicacao.
  linhagem           Linhagem @relation(fields: [idEspecie, idLinhagem], references: [idEspecie, id], onDelete: NoAction, onUpdate: NoAction)
  /// Os reservados (vivos) e os entregues
  animais            Animal[]
  ocorrencias        Ocorrencia[]

  @@index([status, dtDesejada])
  @@map("pedido")
  @@schema("demanda")
}

// ------------------------------------------------------------- auditoria

model Historico {
  id         Int      @id @default(autoincrement())
  /// Nulo quando foi o proprio sistema, sem ninguem da equipe por tras (a
  /// recusa do pedido sem resposta). A tela mostra "Sistema".
  idUsuario  Int?     @map("id_usuario")
  dtHora     DateTime @default(now()) @map("dt_hora") @db.Timestamptz(6)
  entidade   String   @db.VarChar(20)
  idEntidade Int      @map("id_entidade")
  acao       String   @db.VarChar(40)
  descricao  String   @db.VarChar(300)
  dados      Json?

  usuario Usuario? @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entidade, idEntidade])
  @@index([dtHora])
  @@map("historico")
  @@schema("auditoria")
}
